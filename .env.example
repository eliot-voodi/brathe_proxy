# Скопируйте в .env и заполните. install.sh создаёт .env сам при установке.
# Секреты и data/ в git не коммитятся.

PANEL_PORT=8003
HTTP_PROXY_PORT=13128
SOCKS_PROXY_PORT=11080
PANEL_SECRET_KEY=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

PROXY_PUBLIC_HOST=auto
MTPROTO_PUBLIC_HOST=
MTPROTO_PUBLIC_PORT=2053
MTPROTO_SECRET_MODE=faketls
MTPROTO_FAKE_TLS_DOMAIN=yandex.ru

PANEL_DATA_HOST_PATH=./data
PANEL_ALLOW_IPS=
PANEL_ALLOW_IPS_FILE=/data/panel_allow_ips.txt
PANEL_OPERATORS_FILE=/data/panel_operators.json
PANEL_TRUST_X_FORWARDED_FOR=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=

PROXY_LOGDUMP_BYTES=65536
TRAFFIC_POLL_INTERVAL_SECONDS=8.0
TRAFFIC_SAMPLING_INTERVAL_SECONDS=180
TRAFFIC_SAMPLES_PER_USER=false
TRAFFIC_EVENTS_ENABLED=false
TRAFFIC_SAMPLES_RETENTION_HOURS=24

SINGBOX_SOCKS_HOST=10.210.99.10
SINGBOX_SOCKS_PORT=1080
SINGBOX_LOG_LEVEL=warn
